{
  "manifest_version": 1,
  "name": "trade",
  "version": "0.1.0",
  "entities": [
    {
      "name": "Ticker",
      "fields": [
        {
          "name": "symbol",
          "type": "string",
          "optional": false,
          "unique": true
        },
        {
          "name": "name",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "sector",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "price",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "openPrice",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "dayHigh",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "dayLow",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "volume",
          "type": "int",
          "optional": false,
          "unique": false
        },
        {
          "name": "updatedAt",
          "type": "datetime",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": [
        {
          "name": "by_sector",
          "fields": [
            "sector"
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "Trade",
      "fields": [
        {
          "name": "symbol",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "price",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "qty",
          "type": "int",
          "optional": false,
          "unique": false
        },
        {
          "name": "at",
          "type": "datetime",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": [
        {
          "name": "by_symbol_at",
          "fields": [
            "symbol",
            "at"
          ],
          "unique": false
        },
        {
          "name": "by_at",
          "fields": [
            "at"
          ],
          "unique": false
        }
      ]
    },
    {
      "name": "Watch",
      "fields": [
        {
          "name": "userId",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "symbol",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "addedAt",
          "type": "datetime",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": [
        {
          "name": "by_user_symbol",
          "fields": [
            "userId",
            "symbol"
          ],
          "unique": true
        },
        {
          "name": "by_user",
          "fields": [
            "userId"
          ],
          "unique": false
        }
      ]
    }
  ],
  "routes": [
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/page",
      "layouts": [
        "app/layout"
      ]
    }
  ],
  "queries": [],
  "actions": [],
  "policies": [
    {
      "name": "ticker_public",
      "allowRead": "true",
      "allowInsert": "auth.userId != null",
      "allowUpdate": "auth.userId != null",
      "entity": "Ticker"
    },
    {
      "name": "trade_public",
      "allowRead": "true",
      "allowInsert": "auth.userId != null",
      "entity": "Trade"
    },
    {
      "name": "watch_ownership",
      "allowRead": "auth.userId == data.userId",
      "allowInsert": "auth.userId == data.userId",
      "allowDelete": "auth.userId == data.userId",
      "entity": "Watch"
    }
  ],
  "auth": {
    "user": {
      "entity": "User",
      "expose": [],
      "hide": []
    },
    "session": {
      "expires_in": 2592000,
      "cookie_cache": {
        "enabled": false,
        "max_age": 300,
        "claims": [
          "is_admin",
          "tenant_id"
        ]
      }
    },
    "org": {
      "entity": "Org",
      "member_entity": "OrgMember",
      "invite_entity": "OrgInvite",
      "disabled": false
    },
    "trusted_origins": []
  }
}
