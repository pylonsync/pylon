{
  "manifest_version": 1,
  "name": "ssr-hello",
  "version": "0.1.0",
  "entities": [
    {
      "name": "Marker",
      "fields": [
        {
          "name": "note",
          "type": "string",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": []
    }
  ],
  "routes": [
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/page",
      "layouts": [
        "app/layout"
      ]
    },
    {
      "path": "/data",
      "mode": "ssr",
      "component": "app/data/page",
      "layouts": [
        "app/layout"
      ]
    },
    {
      "path": "/gallery",
      "mode": "ssr",
      "component": "app/gallery/page",
      "layouts": [
        "app/layout"
      ]
    },
    {
      "path": "/hello",
      "mode": "ssr",
      "component": "app/hello/page",
      "layouts": [
        "app/layout"
      ]
    },
    {
      "path": "/llms.txt",
      "mode": "ssr",
      "component": "app/llms",
      "kind": "llms"
    },
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/not-found",
      "layouts": [
        "app/layout"
      ],
      "kind": "not-found"
    },
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/error",
      "layouts": [
        "app/layout"
      ],
      "kind": "error"
    }
  ],
  "queries": [],
  "actions": [],
  "policies": [],
  "auth": {
    "user": {
      "entity": "User",
      "expose": [],
      "hide": []
    },
    "session": {
      "expires_in": 2592000,
      "cookie_cache": {
        "enabled": false,
        "max_age": 300,
        "claims": [
          "is_admin",
          "tenant_id"
        ]
      }
    },
    "org": {
      "entity": "Org",
      "member_entity": "OrgMember",
      "invite_entity": "OrgInvite",
      "disabled": false
    },
    "org_roles": [],
    "trusted_origins": []
  },
  "fonts": [
    {
      "family": "Geist",
      "variable": "--font-sans",
      "weights": [
        "400",
        "600"
      ],
      "styles": [
        "normal"
      ],
      "subsets": [
        "latin"
      ],
      "display": "swap",
      "preload": true,
      "adjust_font_fallback": true
    }
  ]
}
