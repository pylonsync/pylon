# URL of the Pylon backend that serves /api/auth/*, /api/entities/*,
# /api/sync/* etc. Vite embeds this into the browser bundle at build
# time, so it must be the public hostname your customers reach.
#
# Local dev: leave unset (the client falls back to http://localhost:4321).
# Vercel:    set to the deployed Pylon hostname, e.g.
#            VITE_PYLON_URL=https://pylon-chat-api.fly.dev
VITE_PYLON_URL=
