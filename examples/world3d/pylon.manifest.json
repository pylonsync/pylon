{
  "manifest_version": 1,
  "name": "world3d",
  "version": "0.2.0",
  "entities": [
    {
      "name": "Avatar",
      "fields": [
        {
          "name": "userId",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "name",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "color",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "x",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "y",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "z",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "heading",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "pitch",
          "type": "float",
          "optional": false,
          "unique": false
        },
        {
          "name": "health",
          "type": "float",
          "optional": true,
          "unique": false
        },
        {
          "name": "lastSeenAt",
          "type": "datetime",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": [
        {
          "name": "by_user",
          "fields": [
            "userId"
          ],
          "unique": true
        }
      ]
    },
    {
      "name": "Destruction",
      "fields": [
        {
          "name": "key",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "userId",
          "type": "string",
          "optional": false,
          "unique": false
        },
        {
          "name": "createdAt",
          "type": "datetime",
          "optional": false,
          "unique": false
        }
      ],
      "indexes": [
        {
          "name": "by_key",
          "fields": [
            "key"
          ],
          "unique": true
        }
      ]
    }
  ],
  "routes": [
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/page",
      "layouts": [
        "app/layout"
      ]
    }
  ],
  "queries": [],
  "actions": [],
  "policies": [
    {
      "name": "avatar_ownership",
      "allowRead": "auth.userId != null",
      "allowInsert": "auth.userId != null",
      "allowUpdate": "auth.userId == data.userId",
      "allowDelete": "auth.userId == data.userId",
      "entity": "Avatar"
    },
    {
      "name": "destruction_append_only",
      "allowRead": "auth.userId != null",
      "allowInsert": "auth.userId != null",
      "allowUpdate": "false",
      "allowDelete": "auth.userId != null",
      "entity": "Destruction"
    }
  ],
  "auth": {
    "user": {
      "entity": "User",
      "expose": [],
      "hide": []
    },
    "session": {
      "expires_in": 2592000,
      "cookie_cache": {
        "enabled": false,
        "max_age": 300,
        "claims": [
          "is_admin",
          "tenant_id"
        ]
      }
    },
    "org": {
      "entity": "Org",
      "member_entity": "OrgMember",
      "invite_entity": "OrgInvite",
      "disabled": false
    },
    "trusted_origins": []
  }
}
