{
  "manifest_version": 1,
  "name": "shard-arena",
  "version": "0.1.0",
  "entities": [],
  "routes": [
    {
      "path": "/",
      "mode": "ssr",
      "component": "app/page",
      "layouts": [
        "app/layout"
      ]
    }
  ],
  "queries": [],
  "actions": [],
  "policies": [],
  "auth": {
    "user": {
      "entity": "User",
      "expose": [],
      "hide": []
    },
    "session": {
      "expires_in": 2592000,
      "cookie_cache": {
        "enabled": false,
        "max_age": 300,
        "claims": [
          "is_admin",
          "tenant_id"
        ]
      }
    },
    "org": {
      "entity": "Org",
      "member_entity": "OrgMember",
      "invite_entity": "OrgInvite",
      "disabled": false
    },
    "org_roles": [],
    "trusted_origins": []
  },
  "shards": [
    {
      "name": "arena",
      "wasm": "shards/arena.wasm",
      "crate": "shards/arena",
      "codec": "msgpack",
      "tickRate": 20,
      "maxInstances": 4,
      "idleShutdownSecs": 0
    }
  ]
}
