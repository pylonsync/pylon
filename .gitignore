# OS / editors
.DS_Store
.idea/
.vscode/

# Rust — match `target/` at any depth (the root-anchored `/target/` missed
# nested Cargo projects like benchmarks/search/target, which committed ~389MB
# of build artifacts and blew past the cloud deploy's 50MB tarball cap).
target/

# Swift / SPM — build artifacts and IDE state
.build/
.swiftpm/
DerivedData/
*.xcodeproj
*.xcworkspace

# JavaScript / Bun
node_modules/
dist/
.bun/

# Environment / local overrides
.env
.env.*
!.env.example
!.env.*.example

# Generated TS client — regenerated on every `pylon dev`
agentdb.client.ts

# Legacy dev-DB layout (pre .pylon/). Keep for old checkouts.
agentdb.dev.db
pylon.dev.db
pylon.dev.db-*
pylon.dev.db.*
pylon.sessions.db
pylon.sessions.db-*
pylon.jobs.db
pylon.jobs.db-*
pylon.workflows.db
pylon.workflows.db-*
*.workflows.db
*.workflows.db-*

# New layout: everything runtime-local under .pylon/ next to app.ts
.pylon/

# File uploads dumped at project root
/uploads/
**/uploads/

# Logs / coverage / temp
*.log
coverage/
tmp/
temp/

# Legacy .statecraft/ runtime dirs and statecraft.*.db files — never commit.
.statecraft/
statecraft.*.db
statecraft.*.db-*
statecraft.jobs.db
statecraft.jobs.db-*

# Build caches / IDE state — never track
.next/
turbopack/
.turbo/
*.sst
*.db-wal
*.db-shm

# Internal adversarial / security review artifacts. These describe
# exploitable findings with file:line citations and should never be
# committed to a public-facing repo. Keep them local — track triage
# in your private notes / issue tracker instead.
REVIEW.md
REVIEW.*.md
/reviews/

# Roadmap is tracked in private planning, not the public repo.
ROADMAP.md
.deepsec/

# Local test scaffolds the user creates while iterating on create-pylon.
yapless/
test-app/
smoke-app/

# Claude Code scheduled-task lockfile (created by ScheduleWakeup tooling)
.claude/

# Per-platform CLI binaries — the actual content (Mach-O / ELF) is
# written by .github/workflows/release.yml at release time and then
# published to npm. Local builds (e.g. `cargo install --path
# crates/cli`) and `./release.sh` populate these bin/ dirs with a
# symlink to target/release/pylon for the host platform only, which
# we don't want to commit.
packages/cli-darwin-arm64/bin/
packages/cli-darwin-x64/bin/
packages/cli-linux-arm64/bin/
packages/cli-linux-x64/bin/
packages/cli-win32-x64/bin/
.gstack/
dump.rdb
