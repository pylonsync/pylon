  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "template:dev": "node packages/create-pylon/dev.mjs"
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "uuid": "^11.1.1"
  },
  "resolutions": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "uuid": "^11.1.1"
  }
