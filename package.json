{
  "name": "pylon",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "!packages/csharp",
    "packages/plugins/*",
    "examples/*",
    "examples/*/web"
  ],
  "devDependencies": {
    "bun-types": "^1.3.14",
    "fake-indexeddb": "^6.2.5",
    "turbo": "^2.5.0",
