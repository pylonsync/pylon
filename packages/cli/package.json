{
  "name": "@pylonsync/cli",
  "version": "0.22.56",
  "description": "Pylon CLI — `pylon dev`, `pylon start`, `pylon migrate`, etc. Bundles the native binary for your platform via optionalDependencies, no postinstall script required.",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://pylonsync.com",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./bin/pylon.js",
  "bin": {
    "pylon": "./bin/pylon.js"
  },
  "files": [
    "bin/pylon.js",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@pylonsync/cli-darwin-arm64": "0.22.56",
    "@pylonsync/cli-linux-x64": "0.22.56",
    "@pylonsync/cli-win32-x64": "0.22.56"
  }
}
