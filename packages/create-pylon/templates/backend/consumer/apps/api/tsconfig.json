{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "app.ts",
    "app/**/*",
    "functions/**/*",
    "lib/**/*"
  ]
}
