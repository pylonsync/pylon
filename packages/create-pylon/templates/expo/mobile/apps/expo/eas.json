{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_PYLON_BASE_URL": "http://localhost:4321"
      },
      "ios": { "simulator": true }
    },
    "device": {
      "extends": "development",
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "APP_BUNDLE_ID": "",
        "EAS_PROJECT_ID": "",
        "EXPO_PUBLIC_PYLON_BASE_URL": ""
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_BUNDLE_ID": "",
        "EAS_PROJECT_ID": "",
        "EXPO_PUBLIC_PYLON_BASE_URL": ""
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
