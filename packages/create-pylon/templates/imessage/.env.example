# Copy to `.env` and fill in. `pylon dev` loads `.env` automatically.
# Never commit .env: it holds your API keys and shared secrets.

# ── Owner ────────────────────────────────────────────────────────────────────
# The dashboard belongs to the account with this email. Sign in at /login with
# an email code; Pylon promotes the account to admin once the code proves the
# address. Everyone else sees nothing.
PYLON_ADMIN_EMAILS=you@example.com

# ── Model provider (required for replies) ───────────────────────────────────
# Without a key, texts are stored and marked "Waiting for setup"; nothing is
# sent back. The model id is in lib/assistant.ts (ASSISTANT_MODEL).
# ANTHROPIC_API_KEY=sk-ant-...
# or: PYLON_LLM_PROVIDER=openai + OPENAI_API_KEY=sk-...  (also change ASSISTANT_MODEL)

# ── Transport: pick one ──────────────────────────────────────────────────────
# sendblue: Sendblue's hosted iMessage API
# relay:    the relay script on your own Mac (relay/)
IMESSAGE_TRANSPORT=sendblue

# Sendblue (https://dashboard.sendblue.com → API keys)
# SENDBLUE_API_KEY=
# SENDBLUE_API_SECRET=
# SENDBLUE_FROM_NUMBER=+15125550100
# Webhook secret: at least 24 random characters (openssl rand -hex 32). Set the
# same value as the webhook secret in Sendblue for the receive webhook
# https://<your app>/api/webhooks/sendblueWebhook
# SENDBLUE_WEBHOOK_SECRET=

# Mac relay: at least 24 random characters (openssl rand -hex 32). The relay's
# relay/.env holds the same value. Treat it like your Apple ID password: its
# holder can post texts as any sender and read every queued reply.
# RELAY_TOKEN=

# Record outbound messages without sending them (both transports).
# IMESSAGE_DRY_RUN=1
#
# `pylon dev` never sends: replies are recorded as "Dry run". A dev server
# listens on your local network and returns sign-in codes in its responses, so
# anyone on the network who knows your email could act as you. Set this only
# on a trusted network, to test real delivery:
# IMESSAGE_ALLOW_DEV_SENDS=1

# ── Production only ──────────────────────────────────────────────────────────
# The server runs the agent as the owner by calling its own API. It needs its
# public origin and the admin token to open that session. `pylon dev` needs
# neither (it falls back to http://127.0.0.1:$PYLON_PORT).
# APP_URL=https://assistant.example.com
# PYLON_ADMIN_TOKEN=
