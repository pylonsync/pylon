# Copy to relay/.env on the Mac that runs the relay. Bun loads it automatically
# when you start the relay from this directory.

# Your app's public origin (https). The relay calls <PYLON_URL>/api/fn/relaySync.
PYLON_URL=https://your-app.example.com

# Same value as RELAY_TOKEN on the server. Generate with: openssl rand -hex 32
RELAY_TOKEN=

# Optional
# CHAT_DB=/Users/you/Library/Messages/chat.db
# RELAY_STATE=/Users/you/.pylon-imessage-relay/state.json
# POLL_MS=3000   (minimum 2500)
# RELAY_DRY_RUN=1
