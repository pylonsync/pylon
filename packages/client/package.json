{
  "name": "@pylonsync/client",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.3.304",
  "type": "module",
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
